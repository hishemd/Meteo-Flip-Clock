<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.HTCWeatherFlipClock"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HTCWeatherFlipClock.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.CityListActivity" android:exported="false"
            android:parentActivityName=".ui.MainActivity" android:theme="@style/Theme.HTCWeatherFlipClock" />
        <activity android:name=".ui.AddCityActivity" android:exported="false"
            android:parentActivityName=".ui.CityListActivity" android:theme="@style/Theme.HTCWeatherFlipClock" />
        <activity android:name=".ui.SettingsActivity" android:exported="false"
            android:parentActivityName=".ui.MainActivity" android:theme="@style/Theme.HTCWeatherFlipClock" />
        <activity android:name=".ui.DetailsActivity" android:exported="false"
            android:parentActivityName=".ui.MainActivity" android:theme="@style/Theme.HTCWeatherFlipClock" />
        <activity android:name=".ui.WeatherPreviewActivity" android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.HTCWeatherFlipClock.Fullscreen"
            android:screenOrientation="portrait" />

        <service
            android:name=".wallpaper.WeatherWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>

        <!-- Widget 1: Large Flip + Weather -->
        <receiver android:name=".widget.Widget1FlipLarge" android:exported="true"
            android:label="@string/widget1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_1_info" />
        </receiver>

        <!-- Widget 2: Clock only -->
        <receiver android:name=".widget.Widget2ClockOnly" android:exported="true"
            android:label="@string/widget2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_2_info" />
        </receiver>

        <!-- Widget 3: Compact weather -->
        <receiver android:name=".widget.Widget3Compact" android:exported="true"
            android:label="@string/widget3_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_3_info" />
        </receiver>

        <!-- Widget 4: Tall vertical -->
        <receiver android:name=".widget.Widget4Tall" android:exported="true"
            android:label="@string/widget4_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_4_info" />
        </receiver>

    </application>
</manifest>
