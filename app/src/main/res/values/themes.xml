<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HTCWeatherFlipClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A1A2E</item>
        <item name="colorPrimaryDark">#0F0F1A</item>
        <item name="colorAccent">#4FC3F7</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#050508</item>
    </style>

    <style name="Theme.HTCWeatherFlipClock.Fullscreen" parent="Theme.HTCWeatherFlipClock">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="FlipDigitLarge">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:background">@drawable/widget_digit_bg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="FlipDigitXLarge">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:background">@drawable/widget_digit_bg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="QuickIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/circle_dark</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">#4FC3F7</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
