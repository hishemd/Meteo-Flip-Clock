<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HTCWeatherFlipClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A1A2E</item>
        <item name="colorPrimaryDark">#0F0F1A</item>
        <item name="colorAccent">#4FC3F7</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#0D0D15</item>
    </style>

    <style name="Theme.HTCWeatherFlipClock.Fullscreen" parent="Theme.HTCWeatherFlipClock">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>

    <style name="WidgetFlipDigit">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#212121</item>
        <item name="android:background">@drawable/widget_digit_bg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
