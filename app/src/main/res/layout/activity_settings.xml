<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D15"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- GPS -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_gps"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:thumbTint="#4FC3F7"
            app:trackTint="#546E7A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gps_help"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/api_key_label"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="#1A1A2E"
            app:boxStrokeColor="#4FC3F7">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/api_key_hint"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/api_key_help"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Temperature unit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temp_unit"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgTempUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbCelsius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="°C Celsius"
                android:textColor="#FFFFFF"
                android:buttonTint="#4FC3F7"
                android:layout_marginEnd="24dp" />

            <RadioButton
                android:id="@+id/rbFahrenheit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="°F Fahrenheit"
                android:textColor="#FFFFFF"
                android:buttonTint="#4FC3F7" />
        </RadioGroup>

        <!-- Auto refresh -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_refresh"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A2E"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Live Wallpaper -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/set_live_wallpaper"
            android:textSize="15sp"
            app:backgroundTint="#1565C0"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_help"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Widget tip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Widget : appui long sur l\'écran d\'accueil → Widgets → Météo Flip Clock"
            android:textColor="#90CAF9"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save"
            android:textSize="16sp"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
