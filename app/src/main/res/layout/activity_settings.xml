<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050508">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="8dp">
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/dot_cyan" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="Paramètres" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#4FC3F7" android:background="@drawable/circle_dark" android:padding="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grand volet mécanique bi-chiffres avec prévisions météo réalistes et animations volumétriques."
                android:textColor="#78909C"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Occupation : 8 blocs écran"
                android:textColor="#546E7A"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <!-- Widget cards info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16161E"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Flip Clock Compact 4×1"
                            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DISPONIBLE" android:textColor="#80CBC4" android:textSize="10sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Ligne fine horizontale. Horloge à micro-volets et icône météo condensée."
                        android:textColor="#78909C" android:textSize="12sp" android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/tvWidgetPreview1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10:48 • Paris 24°C"
                        android:textColor="#B0BEC5" android:textSize="12sp" android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16161E"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Météo Seule 2×2 (Prévisions 3 Jours)"
                            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DISPONIBLE" android:textColor="#80CBC4" android:textSize="10sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Ajoutez depuis l'écran d'accueil → Widgets → Météo Flip Clock."
                        android:textColor="#78909C" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Thème & Volets -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎨 Thème &amp; Volets Tactiles"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16161E"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fond d'écran météo dynamique"
                                android:textColor="#FFFFFF" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Effet gouttes, brouillard et rayons de soleil."
                                android:textColor="#78909C" android:textSize="11sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchDynBg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#4FC3F7"
                            app:trackTint="#37474F" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeRain"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_weight="1" android:text="💧\nPluie"
                            android:textSize="11sp" android:layout_marginEnd="6dp"
                            app:backgroundTint="#1A237E" app:cornerRadius="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeSun"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_weight="1" android:text="☀️\nZénith"
                            android:textSize="11sp" android:layout_marginEnd="6dp"
                            app:backgroundTint="#263238" app:cornerRadius="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnThemeMist"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_weight="1" android:text="☁️\nBrume"
                            android:textSize="11sp"
                            app:backgroundTint="#263238" app:cornerRadius="12dp" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Finition des Volets Mécaniques"
                        android:textColor="#B0BEC5" android:textSize="12sp"
                        android:layout_marginTop="14dp" android:layout_marginBottom="8dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFinishWhite"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:text="BLANC NACRÉ"
                            android:textSize="10sp" android:layout_marginEnd="6dp"
                            app:backgroundTint="#4FC3F7" app:cornerRadius="10dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFinishBlack"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:text="NOIR CARBONE"
                            android:textSize="10sp" android:layout_marginEnd="6dp"
                            app:backgroundTint="#37474F" app:cornerRadius="10dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFinishFrost"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:text="GIVRÉ 3D"
                            android:textSize="10sp"
                            app:backgroundTint="#37474F" app:cornerRadius="10dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="14dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Son d'horlogerie (Clac Volet)"
                                android:textColor="#FFFFFF" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Retour haptique et sonore à chaque minute."
                                android:textColor="#78909C" android:textSize="11sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchFlipSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#4FC3F7"
                            app:trackTint="#37474F" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Données météo -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📡 Données Météorologiques"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#16161E"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Unité de température"
                                android:textColor="#FFFFFF" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Affichage des sondes thermiques"
                                android:textColor="#78909C" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnitC"
                            android:layout_width="48dp" android:layout_height="40dp"
                            android:text="°C" android:textSize="13sp"
                            android:layout_marginEnd="4dp"
                            app:backgroundTint="#4FC3F7" app:cornerRadius="10dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnitF"
                            android:layout_width="48dp" android:layout_height="40dp"
                            android:text="°F" android:textSize="13sp"
                            app:backgroundTint="#37474F" app:cornerRadius="10dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="14dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Utiliser le GPS"
                                android:textColor="#FFFFFF" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Météo de votre position actuelle"
                                android:textColor="#78909C" android:textSize="11sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchGps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="#4FC3F7"
                            app:trackTint="#37474F" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🖼️ Fond d'écran animé"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="#1565C0"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviewWeather"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🎬 Prévisualiser les fonds (hors ligne)"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        app:backgroundTint="#6A1B9A"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Enregistrer"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/tvAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="HTC Diamond Weather Clock v2.0\nFlip Clock • Météo animée • Widgets • Fond live\nFrançais / English / العربية"
                        android:textColor="#546E7A"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#E00A0A10"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_recent_history" app:tint="#78909C" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ACCUEIL" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMeteo" style="@style/NavItem">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_compass" app:tint="#78909C" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MÉTÉO" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navCities" style="@style/NavItem">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation" app:tint="#78909C" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VILLES" android:textColor="#78909C" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_preferences" app:tint="#4FC3F7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PARAMÈTRES" android:textColor="#4FC3F7" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
