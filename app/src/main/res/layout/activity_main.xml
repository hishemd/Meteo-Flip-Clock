<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508">

    <com.htcweather.flipclock.animation.WeatherBackgroundView
        android:id="@+id/weatherBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="8dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_cyan" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Accueil"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#4FC3F7"
                android:background="@drawable/circle_dark"
                android:padding="6dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <!-- Main card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#E0121218"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="center_horizontal">

                        <com.htcweather.flipclock.ui.FlipClockView
                            android:id="@+id/flipClock"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:layout_marginBottom="8dp" />

                        <com.htcweather.flipclock.animation.WeatherIconView
                            android:id="@+id/weatherIcon"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvCityName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Paris"
                            android:textColor="#B0BEC5"
                            android:textSize="14sp"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°C"
                            android:textColor="#FFFFFF"
                            android:textSize="48sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#90A4AE"
                            android:textSize="13sp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHighLow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#90A4AE"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#607D8B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#22FFFFFF"
                            android:layout_marginVertical="12dp" />

                        <!-- Sunrise / wind / pressure -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvSunrise"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#FFCC80"
                                android:textSize="12sp"
                                android:text="☀ --:--" />

                            <TextView
                                android:id="@+id/tvSunset"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#90CAF9"
                                android:textSize="12sp"
                                android:text="☾ --:--" />

                            <TextView
                                android:id="@+id/tvWindRow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp"
                                android:text="💨 -- km/h" />

                            <TextView
                                android:id="@+id/tvPressureRow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp"
                                android:text="-- hPa" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Flip controls -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#CC12121A"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● VOLET MÉCANIQUE SENSE FLIP"
                                android:textColor="#80DEEA"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3D SKEUOMORPH"
                                android:textColor="#FFB74D"
                                android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFlipDemo"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="⚡ Actionner"
                                android:textSize="12sp"
                                app:backgroundTint="#1A237E"
                                app:cornerRadius="12dp"
                                android:layout_marginEnd="8dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFlipLoop"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="▶ Démo Continu"
                                android:textSize="12sp"
                                app:backgroundTint="#263238"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="💡 Touchez l'horloge pour déclencher la bascule"
                            android:textColor="#607D8B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Animated background modes -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#CC12121A"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="💧 FOND ANIMÉ SELON LE TEMPS"
                                android:textColor="#80DEEA"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EN TEMPS RÉEL"
                                android:textColor="#FFB74D"
                                android:textSize="10sp" />
                        </LinearLayout>
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="10dp">
                            <LinearLayout
                                android:id="@+id/weatherModesRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quick actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp">
                    <ImageButton android:id="@+id/btnQuickAlarm" style="@style/QuickIcon"
                        android:src="@android:drawable/ic_lock_idle_alarm" android:contentDescription="Alarm" />
                    <ImageButton android:id="@+id/btnQuickDetails" style="@style/QuickIcon"
                        android:src="@android:drawable/ic_menu_today" android:contentDescription="Details" />
                    <ImageButton android:id="@+id/btnQuickPreview" style="@style/QuickIcon"
                        android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Preview" />
                    <ImageButton android:id="@+id/btnRefresh" style="@style/QuickIcon"
                        android:src="@android:drawable/ic_popup_sync" android:contentDescription="Refresh" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom nav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="#E00A0A10"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">
            <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history" app:tint="#4FC3F7" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ACCUEIL" android:textColor="#4FC3F7" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navMeteo" style="@style/NavItem">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_compass" app:tint="#78909C" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MÉTÉO" android:textColor="#78909C" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navCities" style="@style/NavItem">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_mylocation" app:tint="#78909C" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VILLES" android:textColor="#78909C" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_preferences" app:tint="#78909C" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PARAMÈTRES" android:textColor="#78909C" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
